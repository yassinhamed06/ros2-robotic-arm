<?xml version="1.0"?>
<robot name="robotic_arm">

  <!-- Base -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.04"/>
      <geometry>
        <box size="0.10 0.10 0.08"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.04"/>
      <geometry>
        <box size="0.10 0.10 0.08"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.04"/>
      <mass value="0.5"/>
      <inertia ixx="0.000683" ixy="0" ixz="0"
               iyy="0.000683" iyz="0" izz="0.000833"/>
    </inertial>
  </link>

  <!-- Link 1 -->
  <link name="L1">
    <visual>
      <origin xyz="0 0 0.06"/>
      <geometry>
        <box size="0.04 0.04 0.12"/>
      </geometry>
      <material name="blue">
        <color rgba="0.1 0.3 0.9 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.06"/>
      <geometry>
        <box size="0.04 0.04 0.12"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.06"/>
      <mass value="0.2"/>
      <inertia ixx="0.000267" ixy="0" ixz="0"
               iyy="0.000267" iyz="0" izz="0.000053"/>
    </inertial>
  </link>

  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="L1"/>
    <origin xyz="0 0 0.08"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57"
           effort="10" velocity="2"/>
  </joint>

  <!-- Link 2 -->
  <link name="L2">
    <visual>
      <origin xyz="0.075 0 0"/>
      <geometry>
        <box size="0.15 0.035 0.035"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0.075 0 0"/>
      <geometry>
        <box size="0.15 0.035 0.035"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.075 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="0.000031" ixy="0" ixz="0"
               iyy="0.000297" iyz="0" izz="0.000297"/>
    </inertial>
  </link>

  <joint name="joint2" type="revolute">
    <parent link="L1"/>
    <child link="L2"/>
    <origin xyz="0 0 0.12"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57"
           effort="10" velocity="2"/>
  </joint>

  <!-- Link 3 -->
  <link name="L3">
    <visual>
      <origin xyz="0.045 0 0"/>
      <geometry>
        <box size="0.09 0.03 0.03"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0.045 0 0"/>
      <geometry>
        <box size="0.09 0.03 0.03"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.045 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.000015" ixy="0" ixz="0"
               iyy="0.000075" iyz="0" izz="0.000075"/>
    </inertial>
  </link>

  <joint name="joint3" type="revolute">
    <parent link="L2"/>
    <child link="L3"/>
    <origin xyz="0.15 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57"
           effort="10" velocity="2"/>
  </joint>

  <!-- End Effector -->
  <link name="end_effector">
    <visual>
      <origin xyz="0.03 0 0"/>
      <geometry>
        <box size="0.06 0.025 0.025"/>
      </geometry>
      <material name="red">
        <color rgba="0.9 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.03 0 0"/>
      <geometry>
        <box size="0.06 0.025 0.025"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.03 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.0000052" ixy="0" ixz="0"
               iyy="0.0000176" iyz="0" izz="0.0000176"/>
    </inertial>
  </link>

  <joint name="joint4" type="revolute">
    <parent link="L3"/>
    <child link="end_effector"/>
    <origin xyz="0.09 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57"
           effort="10" velocity="2"/>
  </joint>
<link name="world"/>

  <joint name="base_fixed_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0"/>
  </joint>
<ros2_control name="GazeboSystem" type="system">

    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <joint name="joint1">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint2">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint3">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint4">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

  </ros2_control>
<gazebo>
    <plugin filename="__CONTROL_PLUGIN__"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">

      <robot_param>robot_description</robot_param>

      <robot_param_node>robot_state_publisher</robot_param_node>

      <parameters>__CONTROLLERS_FILE__</parameters>

    </plugin>
  </gazebo>
</robot>
